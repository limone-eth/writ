# Password you type on /login
AUTH_PASSWORD=change-me

# Secret used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string

# libSQL / Turso. Local dev defaults to a file in ./data
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Shown in the header and <title>
NEXT_PUBLIC_SITE_NAME=writ
NEXT_PUBLIC_SITE_TAGLINE=notes, essays, half-thoughts
