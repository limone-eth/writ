# Password you type on /login
AUTH_PASSWORD=change-me

# Secret used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string

# libSQL / Turso. Local dev defaults to a file in ./data
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Shown in the header and <title>
NEXT_PUBLIC_SITE_NAME=Your Name
NEXT_PUBLIC_SITE_TAGLINE=notes, essays, half-thoughts

# Public origin of the site, used for absolute URLs in link previews and the sitemap
NEXT_PUBLIC_SITE_URL=https://blog.example.com

# Import to read (/admin/import). The key is required for imports; the rest is optional.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# Only needed if Jina Reader starts rate limiting link fetches
# JINA_API_KEY=
